# Backend .env — copy to .env and adjust.
# Local dev (matches docker-compose.yml):
DATABASE_URL=postgresql+psycopg2://paypal:paypal@localhost:5432/paypal_analytics

# Production (RDS): postgresql+psycopg2://<user>:<password>@<rds-endpoint>:5432/<dbname>

# Comma-separated list of allowed frontend origins.
# Local dev default (used automatically if this is unset): http://localhost:5173,http://localhost:5174
# Production example: https://d123abc.cloudfront.net
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
